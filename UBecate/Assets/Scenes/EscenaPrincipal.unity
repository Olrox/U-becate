--- !u!114 &561115878
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 561115874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a09bba5dec94446488dcf11bb43a2620, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  menuManager: {fileID: 85264362}
  panelInteraccionClick: {fileID: 735598204}
  panelContenedorDialogo: {fileID: 1219573522}
  tiempoAviso: 10
  dialogeText: {fileID: 258328119}
  nameText: {fileID: 1000078458}
  dialogueLines:
  - speakerName: Yo
    lineText: "Mis amistades de la universidad me platicaron que actualmente hay
      convocatorias para buscar becas; Sin embargo, no tengo la menor idea de c\xF3mo
      solicitar una. Ojal\xE1 tuviera ayuda para realizar este tr\xE1mite."
    audioNarrado: {fileID: 0}
    imagenPersonaje: {fileID: 873761685, guid: 68c2125f35fd05349a2a87dc973e149e, type: 3}
  - speakerName: ???
    lineText: "\xBFMe hablabas a mi?"
    audioNarrado: {fileID: 8300000, guid: 2903bcc5dede2194683ebb1a2ab9af92, type: 3}
    imagenPersonaje: {fileID: 21300000, guid: 2bcc3174402c0e34db0c6d2b8060231b, type: 3}
  - speakerName: Yo
    lineText: "\xBFQui\xE9n est\xE1 ah\xED? No se quien seas pero sal de mi cabeza
      \xA1Ahora!"
    audioNarrado: {fileID: 0}
    imagenPersonaje: {fileID: 873761685, guid: 68c2125f35fd05349a2a87dc973e149e, type: 3}
  - speakerName: "Bequ\xEDn"
    lineText: "Tranquilo, soy Bequ\xEDn, un ente programado\u2026 digo, creado para
      ayudarte en este proceso."
    audioNarrado: {fileID: 8300000, guid: b2fe690d798ab494a8256b1922994a15, type: 3}
    imagenPersonaje: {fileID: 21300000, guid: 2bcc3174402c0e34db0c6d2b8060231b, type: 3}
  - speakerName: Yo
    lineText: "\xBFProgramado?"
    audioNarrado: {fileID: 0}
    imagenPersonaje: {fileID: 873761685, guid: 68c2125f35fd05349a2a87dc973e149e, type: 3}
  - speakerName: "Bequ\xEDn"
    lineText: "Eso no es lo importante. \xBFTe interesar\xEDa tener un apoyo para
      continuar con tu vida de estudiante?."
    audioNarrado: {fileID: 8300000, guid: b9e3371b95a53d14786cffc2d90e752f, type: 3}
    imagenPersonaje: {fileID: 21300000, guid: 2bcc3174402c0e34db0c6d2b8060231b, type: 3}
  - speakerName: Yo
    lineText: ' La verdad es que...'
    audioNarrado: {fileID: 0}
    imagenPersonaje: {fileID: 873761685, guid: 68c2125f35fd05349a2a87dc973e149e, type: 3}
  - speakerName: Yo
    lineText: "(\xBFQu\xE9 deber\xEDa responder?)"
    audioNarrado: {fileID: 0}
    imagenPersonaje: {fileID: 873761685, guid: 68c2125f35fd05349a2a87dc973e149e, type: 3}
  textSpeed: 0.075
  audioSource: {fileID: 992558983}
  permitirSaltarAudio: 0
  imagenPersonajeUI: {fileID: 1859286464}
  panelImagenPersonaje: {fileID: 1219573522}
  usarFadePersonajes: 1
  velocidadFadePersonaje: 2
  botonesDecision:
  - {fileID: 1921299457}
  - {fileID: 919066606}
  negacionText: "Entiendo, ser\xE1 para la pr\xF3xima ocasi\xF3n. Recuerda estar
    atento a https://www.becarios.unam.mx/ donde podr\xE1s encontrar informaci\xF3n
    para cuando decidas solicitar una beca."
  audioNegacion: {fileID: 8300000, guid: baad5dd5ac9ee524e80e96deb24dba65, type: 3}
  reloadDelay: 3
