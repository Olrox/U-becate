  m_Script: {fileID: 11500000, guid: 9bcc29baed0cede439b5a31cba52ef29, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelInicial: {fileID: 1033130780}
  textoInicial: {fileID: 259943898}
  fadeDuration: 3
  dialogeText: {fileID: 753644729}
  nameText: {fileID: 1854684664}
  dialogueLines:
  - speakerName: Goyo
    lineText: "Hola de nuevo, \xBFte acuerdas de m\xED?"
  - speakerName: ____
    lineText: "Claro que s\xED, \xBFhe sido seleccionado para recibir una beca?"
  - speakerName: Goyo
    lineText: "As\xED es."
  - speakerName: ____
    lineText: "\xBFPor qu\xE9 acabo de ver un aviso en mi cabeza?"
  - speakerName: Goyo
    lineText: La magia del cine.
  - speakerName: ____
    lineText: "\u2026 Bueno, \xBFahora que hago?"
  - speakerName: Goyo
    lineText: "Sigue las instrucciones brindadas al momento de ser aceptado, en este
      caso tu tendr\xE1s que ir de manera presencial a pasar tus datos y tu ESTADO
      DE CUENTA bancaria al igual que subir tu estado de cuenta en l\xEDnea."
  - speakerName: Goyo
    lineText: "As\xED que a continuaci\xF3n, adjunta tu ESTADO DE CUENTA como PDF"
  - speakerName: Goyo
    lineText: "Muy bien, ahora me ayudar\xE1s con un trabajo."
  - speakerName: ____
    lineText: "\xA1Espera, eso no estaba en el contratoooo!"
  textSpeed: 0.07
  defaultLineWaitTime: 2
